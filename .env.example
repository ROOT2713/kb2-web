# kb-web 2.0 环境变量配置
# 复制此文件为 .env 并填入实际值

# ── App ──
APP_NAME=kb-web
DEBUG=false

# ── Server ──
HOST=0.0.0.0
PORT=3002

# ── Auth ──
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-password-here

# ── JWT ──
# 必填！生成方式: openssl rand -hex 32
# 不设置或长度不足 32 字符时应用拒绝启动【FIX-003】
JWT_SECRET=

# ── Paths ──
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
DB_PATH=./data/kb.db

# ── Hindsight ──
HINDSIGHT_URL=http://localhost:8080

# ── LLM ──
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ── Embedding ──
EMBEDDING_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# ── MinerU ──
MINERU_API_URL=
MINERU_API_KEY=
